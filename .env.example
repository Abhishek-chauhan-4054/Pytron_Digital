# ─────────────────────────────────────────────────────────────
#  Copy to .env.local for local dev, or add in Vercel →
#  Project → Settings → Environment Variables.
#  Never commit real values (.env.local is git-ignored).
# ─────────────────────────────────────────────────────────────

# ── CMS (Supabase) ── see CMS_SETUP.md
# Without these two the site serves its built-in content and /admin shows a setup notice.
# Supabase → Project Settings → API (or "API Keys"): Project URL + anon / publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — the service_role / secret key. Used only for CMS user management
# (create user, reset password, deactivate, delete). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Contact form → email (https://resend.com). From address must be on a verified domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sahil.chauhan@pytron.in
CONTACT_FROM_EMAIL=Pytron Digital <website@pytron.io>

# Contact form → any webhook (Zapier, Make, n8n, HubSpot/Zoho workflow, Google Sheets via Apps Script, Slack…)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Analytics & ads (loaded only when set; the cookie/privacy pages update automatically)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
